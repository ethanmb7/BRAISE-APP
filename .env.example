# Copy this file to `.env` and fill in real values. `.env` is gitignored — never commit real keys.

# Supabase (optional). The app works fully offline on localStorage without these — see
# src/lib/supabase.ts. The anon key is safe to expose client-side by design (Row Level Security
# enforces access), which is why it's VITE_-prefixed.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Mistral AI (optional — powers Braise's free-text chat in LessonView; the rest of the app works
# without it). Server-only: NOT VITE_-prefixed on purpose. The call happens in a TanStack Start
# server function (src/lib/chat.ts) specifically so this key is never bundled into client code —
# a VITE_-prefixed var would ship straight to the browser, readable by anyone who opens devtools
# on the deployed app. In production, set this as a real server/Worker secret, not a client env var.
MISTRAL_API_KEY=
